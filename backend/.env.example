# copy to .env and fill in
PORT=3001
MONGO_URL=your_mongodb_connection_string

# --- production ---
# NODE_ENV=production            # session cookie becomes HTTPS-only (Secure)
# CLIENT_URL=https://your-app.vercel.app   # allowed frontend origin(s), comma-separated
# TRUST_PROXY=2                  # proxies in front of the app (Vercel rewrite + Render/Railway); check /api/v1/health
