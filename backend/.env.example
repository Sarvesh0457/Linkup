# copy to .env and fill in
PORT=3001
MONGO_URL=your_mongodb_connection_string

# --- production ---
# NODE_ENV=production            # session cookie becomes HTTPS-only (Secure)
# CLIENT_URL=https://your-app.vercel.app   # allowed frontend origin(s), comma-separated
# TRUST_PROXY=4                  # proxy hops in front of the app (Vercel -> Cloudflare -> Render, 4 hops); /api/v1/health must show your IP
# EDGE_IP_HEADER=cf-connecting-ip   # Render only (its Cloudflare edge overwrites this header)
