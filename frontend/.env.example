# copy to .env and fill in

# backend address for the WebSocket (API calls use /api through the proxy)
VITE_SOCKET_URL=http://localhost:3001

# where `npm run dev` / `npm run preview` forward /api to (development only)
VITE_DEV_API=http://localhost:3001

# optional TURN server for users on strict networks (comma-separate several URLs)
# VITE_TURN_URL=turn:your-turn-server:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
